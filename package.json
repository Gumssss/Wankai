{
  "name": "wanba-arena",
  "version": "0.1.0",
  "description": "木昆竞技场：用武器撑地走路的 3D 物理对战小游戏",
  "author": "Zheyu Zhang",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node electron/launch.cjs",
    "dev:host": "node electron/launch.cjs --local-net=host",
    "dev:join": "node electron/launch.cjs --local-net=join",
    "build": "vite build",
    "preview:electron": "node electron/launch.cjs --dist",
    "icon": "node tools/make-icon.mjs",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win dir",
    "dist:mac": "vite build && electron-builder --mac",
    "test": "node --test tests/*.test.js",
    "character:shot": "node tools/character-shot.mjs"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.mukun.arena",
    "productName": "木昆竞技场",
    "copyright": "© 2026 Zheyu Zhang",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/launch.cjs",
      "!electron/local-link.cjs",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "files": [
        "dist/**/*",
        "electron/**/*",
        "!electron/launch.cjs",
        "!electron/local-link.cjs",
        "package.json",
        "!node_modules/steamworks.js/dist/{osx,linux64}/**",
        "!node_modules/steamworks.js/dist/win64/*.lib"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "木昆竞技场",
      "artifactName": "mukun-arena-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "12.0",
      "artifactName": "mukun-arena-${version}-mac-${arch}.${ext}",
      "files": [
        "dist/**/*",
        "electron/**/*",
        "!electron/launch.cjs",
        "!electron/local-link.cjs",
        "package.json",
        "!node_modules/steamworks.js/dist/{win64,linux64}/**"
      ]
    },
    "dmg": {
      "title": "木昆竞技场 ${version}"
    }
  }
}
